{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/work/:slug", "destination": "/", "type": 301 }],
  "headers": [
    {
      "source": "assets/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "**/*.@(png|svg|ico|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
